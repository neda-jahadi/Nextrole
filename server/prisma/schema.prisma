generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company        Company?
}

model Region {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  municipality Municipality[]
  company      Company[]
  job          Job[]
}

model Municipality {
  id       Int    @id @default(autoincrement())
  code     String @unique
  name     String
  regionId Int

  region  Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  company Company[]
  job     Job[]
}

model Company {
  id             Int           @id @default(autoincrement())
  userId         Int           @unique
  name           String
  description    String
  contactEmail   String
  contactPhone   String
  status         CompanyStatus @default(PENDING)
  regionId       Int
  municipalityId Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  region       Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  jobs         Job[]
}

model Job {
  id             Int      @id @default(autoincrement())
  title          String
  type           JobType
  description    String
  salary         String
  companyId      Int
  regionId       Int
  municipalityId Int
  workMode       WorkMode @default(ONSITE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  region       Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
}

enum UserRole {
  USER
  COMPANY
  ADMIN
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobType {
  Full_Time
  Part_Time
  Contract
  Internship
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}
